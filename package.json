{
  "name": "save-return-lookup-ui",
  "version": "2.0.0",
  "description": "A UI that looks up save and return items off a SQL table",
  "main": "server.js",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "debug": "node --inspect server.js",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "build": "hof-build",
    "postinstall": "hof-build"
  },
  "author": "Sulthan Ahmed & Alex Swann",
  "license": "MIT",
  "dependencies": {
    "hof": "^24.6.0",
    "jquery": "^3.7.1",
    "knex": "^3.3.0",
    "ms-schema": "^1.6.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4"
  },
  "resolutions": {
    "minimist": "1.2.8",
    "axios": "^1.20.0",
    "brace-expansion": "^1.1.19",
    "lodash": "^4.18.0",
    "minimatch": "^3.1.3",
    "path-to-regexp": "^0.1.13",
    "picomatch": "^2.3.2",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "underscore": "^1.13.8"
  }
